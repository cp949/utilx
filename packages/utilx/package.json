{
  "name": "@cp949/utilx",
  "version": "2.1.0",
  "description": "브라우저용 문자열, 숫자 파싱, nil 판별, 배열 수정, 오류 값, URL, 바이트 표기, 파일명, 버퍼, cleanup scope, blob, 클립보드 유틸. 런타임 의존성 0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cp949/utilx.git",
    "directory": "packages/utilx"
  },
  "homepage": "https://github.com/cp949/utilx#readme",
  "bugs": {
    "url": "https://github.com/cp949/utilx/issues"
  },
  "keywords": [
    "string",
    "trim",
    "blank",
    "array",
    "url",
    "error",
    "clipboard",
    "bytes",
    "file-size",
    "filename",
    "buffer",
    "disposable",
    "cleanup",
    "abort",
    "blob",
    "download",
    "browser",
    "esm"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:explore": "vitest run -c vitest.explore.config.ts"
  }
}
