{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "hooks": {
    "before:init": "pnpm -w verify",
    "before:git:release": "git add ../../CHANGELOG.md"
  },
  "git": {
    "requireBranch": ["main", "dev"],
    "commitMessage": "chore: v${version} 배포",
    "tagName": "v${version}",
    "tagAnnotation": "v${version}"
  },
  "npm": {
    "publish": true,
    "publishPackageManager": "pnpm",
    "publishArgs": ["--no-git-checks"]
  },
  "github": {
    "release": true,
    "releaseName": "v${version}"
  },
  "plugins": {
    "@release-it/keep-a-changelog": {
      "filename": "../../CHANGELOG.md",
      "addUnreleased": true
    }
  }
}
