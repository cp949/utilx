{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "git": {
    "requireBranch": "main",
    "commitMessage": "chore: v${version} 배포",
    "tagName": "v${version}",
    "tagAnnotation": "v${version}"
  },
  "npm": false,
  "github": {
    "release": true,
    "releaseName": "v${version}"
  },
  "hooks": {
    "before:init": ["npm whoami", "pnpm verify"],
    "before:git:release": "cd packages/utilx && pnpm publish --no-git-checks"
  },
  "plugins": {
    "@release-it/bumper": {
      "in": "packages/utilx/package.json",
      "out": "packages/utilx/package.json"
    },
    "@release-it/keep-a-changelog": {
      "filename": "CHANGELOG.md",
      "addUnreleased": true
    }
  }
}
