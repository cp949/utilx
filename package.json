{
  "name": "utilx",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @cp949/utilx build",
    "lint": "pnpm --filter @cp949/utilx lint",
    "format": "oxfmt \"**/*.{ts,mjs,js,json,md}\"",
    "format:check": "oxfmt --check \"**/*.{ts,mjs,js,json,md}\"",
    "check-types": "pnpm --filter @cp949/utilx check-types",
    "check-types:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "test": "pnpm --filter @cp949/utilx test",
    "test:explore": "pnpm --filter @cp949/utilx test:explore",
    "check:escompat": "node scripts/check-escompat.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "check:readme": "node scripts/sync-readme.mjs --check",
    "sync:readme": "node scripts/sync-readme.mjs --write",
    "check:consumer": "node scripts/check-consumer.mjs",
    "check:bundle": "node scripts/check-bundle.mjs --check",
    "sync:bundle": "node scripts/check-bundle.mjs --write",
    "test:gates": "node --test \"scripts/test/*.test.mjs\"",
    "test:browser": "pnpm build && node scripts/run-browser.mjs chromium-latest",
    "test:browser:chrome83": "pnpm build && node scripts/run-browser.mjs chrome83",
    "verify": "pnpm lint && pnpm format:check && pnpm build && pnpm check:escompat && pnpm check:deps && pnpm check:readme && pnpm check:consumer && pnpm check:bundle && pnpm test:gates && pnpm check-types && pnpm check-types:e2e && pnpm test",
    "release-it": "cd packages/utilx && release-it"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@release-it/keep-a-changelog": "8.0.1",
    "@types/node": "24.13.6",
    "esbuild": "0.28.2",
    "eslint-plugin-es-x": "10.1.0",
    "fast-check": "4.10.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "release-it": "21.1.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
